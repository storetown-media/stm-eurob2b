#: src/Pro/Licence/LicenceTexts.php:118
msgid "The licence server does not accept this key for EuroB2B Pro. Check the key, or contact Storetown Media support."
msgstr "Il server delle licenze non accetta questa chiave per EuroB2B Pro. Controlla la chiave o contatta il supporto di Storetown Media."

