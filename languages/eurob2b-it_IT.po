#: src/Modules/Rules/Admin/RulesPage.php:474
msgid "Internal; customers never see it."
msgstr "Interno; i clienti non lo vedono mai."

#: src/Modules/Rules/Admin/RulesPage.php:490
msgid "shop currency"
msgstr "valuta del negozio"

#: src/Modules/Rules/Admin/RulesPage.php:495
msgid "Amounts are never converted. A rule with prices, fixed amounts or a cart value applies only to customers who pay in this currency; rules with percentages or quantities apply in every currency. Customers of a group with its own currency therefore need their own rules for amounts."
msgstr "Gli importi non vengono mai convertiti. Una regola con prezzi, importi fissi o un valore del carrello si applica solo ai clienti che pagano in questa valuta; le regole con percentuali o quantità si applicano in ogni valuta. I clienti di un gruppo con una propria valuta hanno quindi bisogno di regole proprie per gli importi."

#: src/Modules/Rules/Admin/RulesPage.php:495
msgid "Currency of the amounts"
msgstr "Valuta degli importi"

#: src/Modules/Rules/Admin/RulesPage.php:546
msgid "The rule applies when any ticked audience matches the visitor."
msgstr "La regola si applica quando uno qualsiasi dei destinatari selezionati corrisponde al visitatore."

#: src/Modules/Rules/Admin/RulesPage.php:554
msgid "Search products…"
msgstr "Cerca prodotti…"

#: src/Modules/Rules/Admin/RulesPage.php:569
msgid "Choose tags…"
msgstr "Scegli i tag…"

#: src/Modules/Rules/Admin/RulesPage.php:584
msgid "A product rule covers its variations; a category rule covers the category and its sub-categories."
msgstr "Una regola di prodotto copre le sue variazioni; una regola di categoria copre la categoria e le sue sottocategorie."

#: src/Modules/Rules/Admin/RulesPage.php:591
msgid "Date window"
