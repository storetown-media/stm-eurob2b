#: src/Modules/Tax/TaxModule.php:215
msgid "Required for business customers"
msgstr "Pflicht für Geschäftskunden"

#: src/Modules/Tax/TaxModule.php:223
msgid "Countries whose VAT IDs are checked at checkout"
msgstr "Länder, deren USt-IdNrn. in der Kasse geprüft werden"

#: src/Modules/Tax/TaxModule.php:224
msgid "The field is shown at checkout for every billing country; a number is checked (and required, where the field is mandatory) only for these billing countries."
msgstr "Das Feld erscheint in der Kasse für jedes Rechnungsland; geprüft (und, wo das Feld Pflicht ist, verlangt) wird eine Nummer nur für diese Rechnungsländer."

#: src/Modules/Tax/TaxModule.php:234
msgid "Check at registration"
msgstr "Prüfung bei der Registrierung"

#: src/Modules/Tax/TaxModule.php:235
msgid "Check the VAT ID online when a business customer registers"
msgstr "Die USt-IdNr. online prüfen, wenn sich ein Geschäftskunde registriert"

#: src/Modules/Tax/TaxModule.php:244
msgid "Invalid numbers"
msgstr "Ungültige Nummern"

#: src/Modules/Tax/TaxModule.php:245
