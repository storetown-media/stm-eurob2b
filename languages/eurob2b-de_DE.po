msgid "Who sees the order form"
msgstr "Wer das Bestellformular sieht"

#: src/Modules/Ordering/OrderingModule.php:155
msgid "Audience tokens separated by commas: all, registered, b2b, b2c, guest, group:<id>, user:<id>. Empty: business customers only."
msgstr "Zielgruppen-Token, durch Kommas getrennt: all, registered, b2b, b2c, guest, group:<id>, user:<id>. Leer: nur Geschäftskunden."

