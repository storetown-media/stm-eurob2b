msgid "Shop staff on the product screen, on the user profile and in the rules (capability eurob2b_manage_rules)"
msgstr "Shop-Mitarbeiter in der Produktbearbeitung, im Benutzerprofil und in den Regeln (Berechtigung eurob2b_manage_rules)"

#: src/Modules/Privacy/ProcessingRecord.php:244
