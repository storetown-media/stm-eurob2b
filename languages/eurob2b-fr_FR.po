#: src/Modules/Coupons/CouponRestrictions.php:192
#: src/Modules/Customers/GroupRepository.php:323
#: src/Modules/Rules/Admin/RulesPage.php:815
msgid "Private customers"
msgstr "Clients particuliers"

#: src/Modules/Access/Admin/VisibilityFields.php:72
#: src/Modules/Coupons/CouponRestrictions.php:191
