msgstr "Klienci z indywidualnymi warunkami, w szczególności jednoosobowi przedsiębiorcy"

#: src/Modules/Privacy/ProcessingRecord.php:268
msgid "Own regular, sale and tier prices per product or variation"
msgstr "Indywidualne ceny regularne, promocyjne i progowe dla produktu lub wariantu"

#: src/Modules/Privacy/ProcessingRecord.php:269
msgid "Lists of the payment and shipping methods allowed for the customer"
msgstr "Listy metod płatności i wysyłki dozwolonych dla klienta"

