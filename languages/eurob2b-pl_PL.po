#: src/Modules/Privacy/ProcessingRecord.php:199
msgid "As long as the customer account exists."
msgstr "Tak długo, jak istnieje konto klienta."

#: src/Modules/Privacy/ProcessingRecord.php:202
msgid "Rejected applications that were never approved: deleted %d day after the rejection, unless orders were placed with the account or it has other roles."
msgid_plural "Rejected applications that were never approved: deleted %d days after the rejection, unless orders were placed with the account or it has other roles."
msgstr[0] "Odrzucone wnioski, które nigdy nie zostały zatwierdzone: usuwane %d dzień po odrzuceniu, chyba że z konta złożono zamówienia lub ma ono inne role."
msgstr[1] "Odrzucone wnioski, które nigdy nie zostały zatwierdzone: usuwane %d dni po odrzuceniu, chyba że z konta złożono zamówienia lub ma ono inne role."
msgstr[2] "Odrzucone wnioski, które nigdy nie zostały zatwierdzone: usuwane %d dni po odrzuceniu, chyba że z konta złożono zamówienia lub ma ono inne role."

#: src/Modules/Privacy/ProcessingRecord.php:203
msgid "Rejected applications: kept until deleted manually (automatic deletion is switched off in the settings)."
msgstr "Odrzucone wnioski: przechowywane do ręcznego usunięcia (automatyczne usuwanie jest wyłączone w ustawieniach)."

#: src/Modules/Privacy/ProcessingRecord.php:204
msgid "Copies of registration fields on orders: with the order; removed when WooCommerce anonymises the order."
msgstr "Kopie pól rejestracji w zamówieniach: razem z zamówieniem; usuwane, gdy WooCommerce anonimizuje zamówienie."

#: src/Modules/Privacy/ProcessingRecord.php:209
msgid "Documents uploaded with the registration (for example a trade licence): the file, its original name, type and size, and the time of the upload"
msgstr "Dokumenty przesłane przy rejestracji (np. wpis do ewidencji działalności gospodarczej): plik, jego oryginalna nazwa, typ i rozmiar oraz czas przesłania"

#: src/Modules/Privacy/ProcessingRecord.php:210
msgid "Shop staff with the capability to manage customers, through a protected download link; the files cannot be downloaded publicly"
msgstr "Pracownicy sklepu z uprawnieniem do zarządzania klientami, przez chroniony link do pobrania; plików nie można pobrać publicznie"

#: src/Modules/Privacy/ProcessingRecord.php:213
msgid "Uploaded documents: deleted %d day after the approval or rejection, at the latest with the customer account or on an erasure request."
msgid_plural "Uploaded documents: deleted %d days after the approval or rejection, at the latest with the customer account or on an erasure request."
msgstr[0] "Przesłane dokumenty: usuwane %d dzień po zatwierdzeniu lub odrzuceniu, najpóźniej wraz z kontem klienta lub na żądanie usunięcia danych."
msgstr[1] "Przesłane dokumenty: usuwane %d dni po zatwierdzeniu lub odrzuceniu, najpóźniej wraz z kontem klienta lub na żądanie usunięcia danych."
msgstr[2] "Przesłane dokumenty: usuwane %d dni po zatwierdzeniu lub odrzuceniu, najpóźniej wraz z kontem klienta lub na żądanie usunięcia danych."

#: src/Modules/Privacy/ProcessingRecord.php:214
msgid "Uploaded documents: kept as long as the customer account exists; deleted with it or on an erasure request."
msgstr "Przesłane dokumenty: przechowywane tak długo, jak istnieje konto klienta; usuwane razem z nim lub na żądanie usunięcia danych."

#: src/Modules/Privacy/ProcessingRecord.php:219
msgid "Business customer registration and approval"
msgstr "Rejestracja i zatwierdzanie klientów biznesowych"

#: src/Modules/Privacy/ProcessingRecord.php:221
msgid "Reviewing applications for a business customer account and approving or rejecting them."
msgstr "Rozpatrywanie wniosków o konto klienta biznesowego oraz ich zatwierdzanie lub odrzucanie."

#: src/Modules/Privacy/ProcessingRecord.php:222
msgid "Classifying customers as business or consumer customers and assigning them to a customer group, which decides prices, payment methods and visible products."
msgstr "Klasyfikowanie klientów jako biznesowych lub konsumentów i przypisywanie ich do grupy klientów, która decyduje o cenach, metodach płatności i widocznych produktach."

#: src/Modules/Privacy/ProcessingRecord.php:223
msgid "Recording who approved or rejected an account and when."
msgstr "Zapisywanie, kto i kiedy zatwierdził lub odrzucił konto."

#: src/Modules/Privacy/ProcessingRecord.php:226
msgid "Applicants for a business customer account (sole traders and contact persons of companies)"
msgstr "Osoby ubiegające się o konto klienta biznesowego (jednoosobowi przedsiębiorcy i osoby kontaktowe firm)"

#: src/Modules/Privacy/ProcessingRecord.php:227
msgid "Customers with a customer account"
msgstr "Klienci z kontem klienta"

#: src/Modules/Privacy/ProcessingRecord.php:228
msgid "Shop staff who approve or reject applications (user ID only)"
msgstr "Pracownicy sklepu, którzy zatwierdzają lub odrzucają wnioski (wyłącznie ID użytkownika)"

#: src/Modules/Privacy/ProcessingRecord.php:234
msgid "Art. 6(1)(b) GDPR: contract and steps prior to entering into a contract at the request of the applicant"
msgstr "Art. 6(1)(b) RODO: umowa i działania przed zawarciem umowy na żądanie wnioskodawcy"

